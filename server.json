{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tidybytetools/json-shaper-lite",
  "title": "json-shaper-lite",
  "description": "Turn key: value notes, CSV/TSV and Markdown tables into typed JSON. Plain code, no AI, runs locally.",
  "repository": {
    "url": "https://github.com/tidybytetools/json-shaper-lite",
    "source": "github"
  },
  "websiteUrl": "https://github.com/tidybytetools/json-shaper-lite",
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "json-shaper-lite",
      "version": "1.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Starts the MCP server instead of the command-line tool."
        }
      ]
    }
  ]
}
